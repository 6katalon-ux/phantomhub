[Unit]
Description=VPN Store Web Admin Panel & API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vpn_store
ExecStart=/opt/vpn_store/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment="PYTHONPATH=/opt/vpn_store"
Environment="PYTHONUNBUFFERED=1"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
