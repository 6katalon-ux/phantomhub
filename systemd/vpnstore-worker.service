[Unit]
Description=VPN Store Traffic Sync & Background Scheduler
After=network.target vpnstore-web.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vpn_store
ExecStart=/opt/vpn_store/.venv/bin/python -m app.workers.scheduler
Restart=always
RestartSec=10
Environment="PYTHONPATH=/opt/vpn_store"
Environment="PYTHONUNBUFFERED=1"
StandardOutput=append:/opt/vpn_store/logs/worker.log
StandardError=append:/opt/vpn_store/logs/worker_error.log

[Install]
WantedBy=multi-user.target
