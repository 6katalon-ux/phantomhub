[Unit]
Description=VPN Store Traffic Sync & Background Scheduler
After=network.target vpnstore-web.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vpn_store
ExecStart=/opt/vpn_store/.venv/bin/python -m app.workers.scheduler
Restart=always
RestartSec=10
Environment="PYTHONPATH=/opt/vpn_store"
Environment="PYTHONUNBUFFERED=1"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
